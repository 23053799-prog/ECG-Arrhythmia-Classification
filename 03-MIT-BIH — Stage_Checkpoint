s].copy()\n\n        y_train = y.iloc[\n            train_idx\n        ].copy()\n\n        # ----------------------------------------------------\n        # Validation data\n        # ----------------------------------------------------\n\n        X_val = derivative_features.iloc[\n            val_idx\n        ][selected_features].copy()\n\n        y_val = y.iloc[\n            val_idx\n        ].copy()\n\n        # Reset indices\n        X_train = X_train.reset_index(drop=True)\n        y_train = y_train.reset_index(drop=True)\n\n        X_val = X_val.reset_index(drop=True)\n        y_val = y_val.reset_index(drop=True)\n\n        # ----------------------------------------------------\n        # RANDOM OVERSAMPLING\n        #\n        # IMPORTANT:\n        # ONLY TRAINING DATA IS BALANCED.\n        # ----------------------------------------------------\n\n        sampler = RandomOverSampler(\n            random_state=42\n        )\n\n        X_train_balanced, y_train_balanced = (\n            sampler.fit_resample(\n                X_train,\n                y_train\n            )\n        )\n\n        print(\n            f\"Training: {len(y_train):,} \"\n            f\"→ {len(y_train_balanced):,}\"\n        )\n\n        print(\n            f\"Validation: {len(y_val):,}\"\n        )\n\n        # ----------------------------------------------------\n        # TRAIN CLASSIFIER\n        # ----------------------------------------------------\n\n        classifier.fit(\n            X_train_balanced,\n            y_train_balanced\n        )\n\n        # ----------------------------------------------------\n        # VALIDATION\n        # ----------------------------------------------------\n\n        y_pred = classifier.predict(\n            X_val\n        )\n\n        # ----------------------------------------------------\n        # METRICS\n        # ----------------------------------------------------\n\n        accuracy = accuracy_score(\n            y_val,\n            