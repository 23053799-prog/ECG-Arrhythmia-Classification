----------\n\n    train_idx = fold_data[\n        f\"fold_{fold}\"\n    ][\"train_idx\"]\n\n    val_idx = fold_data[\n        f\"fold_{fold}\"\n    ][\"val_idx\"]\n\n    # --------------------------------------------------------\n    # Exact ANOVA-selected features\n    # --------------------------------------------------------\n\n    selected_features = anova_fold_features[\n        f\"fold_{fold}\"\n    ]\n\n    X_train = derivative_features.iloc[\n        train_idx\n    ][selected_features].copy()\n\n    X_val = derivative_features.iloc[\n        val_idx\n    ][selected_features].copy()\n\n    y_train = y.iloc[\n        train_idx\n    ].copy()\n\n    y_val = y.iloc[\n        val_idx\n    ].copy()\n\n    # Reset indices\n    X_train = X_train.reset_index(drop=True)\n    X_val = X_val.reset_index(drop=True)\n\n    y_train = y_train.reset_index(drop=True)\n    y_val = y_val.reset_index(drop=True)\n\n    # --------------------------------------------------------\n    # Random Oversampling — TRAINING ONLY\n    # --------------------------------------------------------\n\n    sampler = RandomOverSampler(\n        random_state=42\n    )\n\n    X_train_balanced, y_train_balanced = sampler.fit_resample(\n        X_train,\n        y_train\n    )\n\n    print(\n        f\"Training: {len(y_train):,} \"\n        f\"→ {len(y_train_balanced):,}\"\n    )\n\n    print(\n        f\"Validation: {len(y_val):,}\"\n    )\n\n    # --------------------------------------------------------\n    # Convert labels ONLY for XGBoost\n    # --------------------------------------------------------\n\n    y_train_xgb = y_train_balanced.map(\n        label_to_int\n    ).astype(int)\n\n    # --------------------------------------------------------\n    # XGBoost\n    # --------------------------------------------------------\n\n    xgb = XGBClassifier(\n        n_estimators=100,\n        max_depth=6,\n        learning_rate=0.1,\n        subsample=0.8,\n        colsample_bytree=0.8,\n        objective=\"multi:softmax\",\n        num_class=5,\n        eval_metric=\"mlogloss\",\n        random_state=42,\n        n_jobs=-1\n    )\n\n    xgb.fit(\n        X_train_balanced,\n        y_train_xgb\n    )\n\n    # --------------------------------------------------------\n    # Predict\n    # --------------------------------------------------------\n\n    y_pred_int = xgb.predict(\n        X_val\n    )\n\n    # Convert predictions back to F/N/Q/S/V\n    y_pred = pd.Series(\n        y_pred_int\n    ).map(\n        int_to_label\n    ).values\n\n    # --------------------------------------------------------\n    # Metrics\n    # --------------------------------------------------------\n\n    accuracy = accuracy_score(\n        y_val,\n        y_pred\n    )\n\n    balanced_accuracy = balanced_accuracy_score(\n        y_val,\n        y_pred\n    )\n\n    macro_f1 = f1_score(\n        y_val,\n        y_pred,\n        average=\"macro\",\n        zero_division=0\n    )\n\n    print(\n        f\"Accuracy: {accuracy:.6f}\"\n    )\n\n    print(\n        f\"Balanced Accuracy: \"\n        f\"{balanced_accuracy:.6f}\"\n    )\n\n    print(\n        f\"Macro F1: {macro_f1:.6f}\"\n    )\n\n    xgb_fold_results.append({\n        \"Classifier\": \"XGBoost\",\n        \"Fold\": fold,\n        \"Accuracy\": accuracy,\n        \"Balanced_Accuracy\": balanced_accuracy,\n        \"Macro_F1\": macro_f1\n    })\n\n    print(\n        f\"Fold time: \"\n        f\"{time.time() - fold_start:.1f} sec\"\n    )\n\n\n# ============================================================\n# XGBOOST SUMMARY\n# ============================================================\n\nxgb_fold_df = pd.DataFrame(\n    xgb_fold_results\n)\n\nxgb_summary = {\n    \"Classifier\": \"XGBoost\",\n    \"Accuracy\": xgb_fold_df[\"Accuracy\"].mean(),\n    \"Balanced_Accuracy\": xgb_fold_df[\"Balanced_Accuracy\"].mean(),\n    \"Macro_F1\": xgb_fold_df[\"Macro_F1\"].mean()\n}\n\nprint(\"\\nXGBoost total time:\",\n      f\"{time.time() - xgb_start:.1f} sec\")\n\n\n# ============================================================\n# CONTROLLED EXPERIMENT:\n# STANDARD SCALER + LOGISTIC REGRESSION\n# ============================================================\n\nprint(\"\\n\" + \"=\" * 70)\nprint(\"===== StandardScaler + Logistic Regression =====\")\nprint(\"=\" * 70)\n\nscaled_lr_fold_results = []\n\nscaled_lr_start = time.time()\n\nfor fold in range(1, 6):\n\n    print(f\"\\nFold {fold}\")\n\n    fold_start = time.time()\n\n    # --------------------------------------------------------\n    # Fold indices\n    # --------------------------------------------------------\n\n    train_idx = fold_data[\n        f\"fold_{fold}\"\n    ][\"train_idx\"]\n\n    val_idx = fold_data[\n        f\"fold_{fold}\"\n    ][\"val_idx\"]\n\n    # --------------------------------------------------------\n    # Exact ANOVA-selected features\n    # --------------------------------------------------------\n\n    selected_features = anova_fold_features[\n        f\"fold_{fold}\"\n    ]\n\n    X_train = derivative_features.iloc[\n        train_idx\n    ][selected_features].copy()\n\n    X_val = derivative_features.iloc[\n        val_idx\n    ][selected_features].copy()\n\n    y_train = y.iloc[\n        train_idx\n    ].copy()\n\n    y_val = y.iloc[\n        val_idx\n    ].copy()\n\n    # --------------------------------------------------------\n    # Reset indices\n    # --------------------------------------------------------\n\n    X_train = X_train.reset_index(drop=True)\n    X_val = X_val.reset_index(drop=True)\n\n    y_train = y_train.reset_index(drop=True)\n    y_val = y_val.reset_index(drop=True)\n\n    # --------------------------------------------------------\n    # STANDARDIZATION\n    #\n    # IMPORTANT:\n    # Fit scaler ONLY on original training fold.\n    # --------------------------------------------------------\n\n    scaler = StandardScaler()\n\n    X_train_scaled = scaler.fit_transform(\n        X_train\n    )\n\n    X_val_scaled = scaler.transform(\n        X_val\n    )\n\n    # --------------------------------------------------------\n    # Random Oversampling\n    #\n    # Per our controlled comparison:\n    # scaling happens first, then training data is balanced.\n    # Validation remains untouched.\n    # --------------------------------------------------------\n\n    sampler = RandomOverSampler(\n        random_state=42\n    )\n\n    X_train_balanced, y_train_balanced = sampler.fit_resample(\n        X_train_scaled,\n        y_train\n    )\n\n    print(\n        f\"Training: {len(y_train):,} \"\n        f\"→ {len(y_train_balanced):,}\"\n    )\n\n    print(\n        f\"Validation: {len(y_val):,}\"\n    )\n\n    # --------------------------------------------------------\n    # Logistic Regression\n    # --------------------------------------------------------\n\n    lr_scaled = LogisticRegression(\n        max_iter=3000,\n        solver=\"lbfgs\",\n        random_state=42,\n        n_jobs=-1\n    )\n\n    lr_scaled.fit(\n        X_train_balanced,\n        y_train_balanced\n    )\n\n    # --------------------------------------------------------\n    # Prediction\n    # --------------------------------------------------------\n\n    y_pred = lr_scaled.predict(\n        X_val_scaled\n    )\n\n    # --------------------------------------------------------\n    # Metrics\n    # --------------------------------------------------------\n\n    accuracy = accuracy_score(\n        y_val,\n        y_pred\n    )\n\n    balanced_accuracy = balanced_accuracy_score(\n        y_val,\n        y_pred\n    )\n\n    macro_f1 = f1_score(\n        y_val,\n        y_pred,\n        average=\"macro\",\n        zero_division=0\n    )\n\n    print(\n        f\"Accuracy: {accuracy:.6f}\"\n    )\n\n    print(\n        f\"Balanced Accuracy: \"\n        f\"{balanced_accuracy:.6f}\"\n    )\n\n    print(\n        f\"Macro F1: {macro_f1:.6f}\"\n    )\n\n    scaled_lr_fold_results.append({\n        \"Classifier\": \"Logistic Regression + StandardScaler\",\n        \"Fold\": fold,\n        \"Accuracy\": accuracy,\n        \"Balanced_Accuracy\": balanced_accuracy,\n        \"Macro_F1\": macro_f1\n    })\n\n    print(\n        f\"Fold time: \"\n        f\"{time.time() - fold_start:.1f} sec\"\n    )\n\n\n# ============================================================\n# SCALED LR SUMMARY\n# ============================================================\n\nscaled_lr_fold_df = pd.DataFrame(\n    scaled_lr_fold_results\n)\n\nscaled_lr_summary = {\n    \"Classifier\": \"Logistic Regression + StandardScaler\",\n    \"Accuracy\": scaled_lr_fold_df[\"Accuracy\"].mean(),\n    \"Balanced_Accuracy\": scaled_lr_fold_df[\"Balanced_Accuracy\"].mean(),\n    \"Macro_F1\": scaled_lr_fold_df[\"Macro_F1\"].mean()\n}\n\nprint(\"\\nScaled LR total time:\",\n      f\"{time.time() - scaled_lr_start:.1f} sec\")\n\n\n# ============================================================\n# ADD TO EXISTING STAGE 6 RESULTS\n# ============================================================\n\n# Existing valid summaries from the previous run\nexisting_results = pd.DataFrame([\n    {\n        \"Classifier\": \"Random Forest\",\n        \"Accuracy\": 0.880392,\n        \"Balanced_Accuracy\": 0.356680,\n        \"Macro_F1\": 0.345932\n    },\n    {\n        \"Classifier\": \"Logistic Regression\",\n        \"Accuracy\": np.mean([\n            0.594842,\n            0.456344,\n            0.306472,\n            0.312584,\n            0.593283\n        ]),\n        \"Balanced_Accuracy\": np.mean([\n            0.368486,\n            0.514252,\n            0.526530,\n            0.333536,\n            0.325725\n        ]),\n        \"Macro_F1\": np.mean([\n            0.281076,\n            0.383805,\n            0.363715,\n            0.152968,\n            0.316286\n        ])\n    },\n    {\n        \"Classifier\": \"Linear SVM\",\n        \"Accuracy\": np.mean([\n            0.612512,\n            0.372938,\n            0.275598,\n            0.245267,\n            0.405378\n        ]),\n        \"Balanced_Accuracy\": np.mean([\n            0.323628,\n            0.501163,\n            0.530803,\n            0.332602,\n            0.313640\n        ]),\n        \"Macro_F1\": np.mean([\n            0.248207,\n            0.339034,\n            0.346112,\n            0.125600,\n            0.270216\n        ])\n    }\n])\n\nfinal_stage6_results = pd.concat(\n    [\n        existing_results,\n        pd.DataFrame([\n            xgb_summary,\n            scaled_lr_summary\n        ])\n    ],\n    ignore_index=True\n)\n\nfinal_stage6_results = final_stage6_results.sort_values(\n    \"Macro_F1\",\n    ascending=False\n).reset_index(drop=True)\n\nprint(\"\\n\")\nprint(\"=\" * 70)\nprint(\"STAGE 6 — COMPLETE COMPARISON\")\nprint(\"=\" * 70)\n\ndisplay(\n    final_stage6_results\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-21T04:19:29.091776Z","iopub.execute_input":"2026-08-21T04:19:29.093029Z","iopub.status.idle":"2026-08-21T04:21:01.018478Z","shell.execute_reply.started":"2026-08-21T04:19:29.092982Z","shell.execute_reply":"2026-08-21T04:21:01.017388Z"}},"outputs":[{"name":"stdout","text":"\n======================================================================\n===== XGBoost =====\n======================================================================\n\nFold 1\nTraining: 80,543 → 342,970\nValidation: 24,504\nAccuracy: 0.766773\nBalanced Accuracy: 0.357228\nMacro F1: 0.283956\nFold time: 9.5 sec\n\nFold 2\nTraining: 80,984 → 360,175\nValidation: 24,063\nAccuracy: 0.742468\nBalanced Accuracy: 0.525323\nMacro F1: 0.509354\nFold time: 9.4 sec\n\nFold 3\nTraining: 86,520 → 377,230\nValidation: 18,527\nAccuracy: 0.602958\nBalanced Accuracy: 0.312142\nMacro F1: 0.275357\nFold time: 9.6 sec\n\nFold 4\nTraining: 86,508 → 366,365\nValidation: 18,539\nAccuracy: 0.560117\nBalanced Accuracy: 0.359453\nMacro F1: 0.203681\nFold time: 9.1 sec\n\nFold 5\nTraining: