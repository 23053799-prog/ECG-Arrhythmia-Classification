n    ][selected_features].copy()\n\n    y_outer_train = y.iloc[\n        train_idx\n    ].copy()\n\n    X_outer_val = derivative_features.iloc[\n        val_idx\n    ][selected_features].copy()\n\n    y_outer_val = y.iloc[\n        val_idx\n    ].copy()\n\n    # Reset indices\n    X_outer_train = X_outer_train.reset_index(drop=True)\n    y_outer_train = y_outer_train.reset_index(drop=True)\n\n    X_outer_val = X_outer_val.reset_index(drop=True)\n    y_outer_val = y_outer_val.reset_index(drop=True)\n\n    # Groups for inner CV\n    outer_groups = groups.iloc[\n        train_idx\n    ].reset_index(drop=True)\n\n    inner_cv = StratifiedGroupKFold(\n        n_splits=3,\n        shuffle=True,\n        random_state=42\n    )\n\n    # --------------------------------------------------------\n    # Optuna objective\n    # --------------------------------------------------------\n\n    def objective(trial):\n\n        params = {\n            \"n_estimators\": trial.suggest_categorical(\n                \"n_estimators\",\n                [100, 200]\n            ),\n\n            \"max_depth\": trial.suggest_categorical(\n                \"max_depth\",\n                [None, 20]\n            ),\n\n            \"min_samples_split\": trial.suggest_categorical(\n                \"min_samples_split\",\n                [2, 5]\n            ),\n\n            \"min_samples_leaf\": trial.suggest_categorical(\n                \"min_samples_leaf\",\n                [1, 2]\n            ),\n\n            \"max_features\": trial.suggest_categorical(\n                \"max_features\",\n                [\"sqrt\", \"log2\"]\n            )\n        }\n\n        inner_scores = []\n\n        # ----------------------------------------------------\n        # 3-fold INNER CV\n        # ----------------------------------------------------\n\n        for inner_train_idx, inner_val_idx in inner_cv.split(\n            X_outer_train,\n            y_outer_train,\n            groups=outer_groups\n        ):\n\n            X_inner_train = X_outer_train.iloc[\n                inner_train_idx\n            ]\n\n            X_inner_val = X_outer_train.iloc[\n                inner_val_idx\n            ]\n\n            y_inner_train = y_outer_train.iloc[\n                inner_train_idx\n            ]\n\n            y_inner_val = y_outer_train.iloc[\n                inner_val_idx\n            ]\n\n            # ------------------------------------------------\n            # Balance INNER TRAINING data only\n            # ------------------------------------------------\n\n            sampler = RandomOverSampler(\n                random_state=42\n            )\n\n            X_balanced, y_balanced = sampler.fit_resample(\n                X_inner_train,\n                y_inner_train\n            )\n\n            # ------------------------------------------------\n            # Train RF\n            # ------------------------------------------------\n\n            rf = RandomForestClassifier(\n                random_state=42,\n                n_jobs=-1,\n                **params\n            )\n\n            rf.fit(\n                X_balanced,\n                y_balanced\n            )\n\n            y_pred = rf.predict(\n                X_inner_val\n            )\n\n            score = f1_score(\n                y_inner_val,\n                y_pred,\n                average=\"macro\",\n                zero_division=0\n            )\n\n            inner_scores.append(score)\n\n        return np.mean(inner_scores)\n\n    # --------------------------------------------------------\n    # Create Optuna study\n    # --------------------------------------------------------\n\n    study = optuna.create_study(\n        direction=\"maximize\",\n        sampler=optuna.samplers.TPESampler(\n            seed=42\n        )\n    )\n\n    # Suppress Optuna's trial-by-trial logging\n    optuna.logging.set_verbosity(\n        optuna.logging.WARNING\n    )\n\n    study.optimize(\n        objective,\n        n_trials=N_TRIALS,\n        show_progress_bar=False\n    )\n\n    # --------------------------------------------------------\n    # Best parameters\n    # --------------------------------------------------------\n\n    best_params = study.best_params\n\n    # Optuna may store None correctly through categorical search\n    print(\"\\nBest parameters:\")\n    print(best_params)\n\n    print(\n        f\"Best inner Macro F1: \"\n        f\"{study.best_value:.6f}\"\n    )\n\n    # --------------------------------------------------------\n    # Refit on complete outer training fold\n    # --------------------------------------------------------\n\n    sampler = RandomOverSampler(\n        random_state=42\n    )\n\n    X_train_balanced, y_train_balanced = sampler.fit_resample(\n        X_outer_train,\n        y_outer_train\n    )\n\n    best_rf = RandomForestClassifier(\n        random_state=42,\n        n_jobs=-1,\n        **best_params\n    )\n\n    best_rf.fit(\n        X_train_balanced,\n        y_train_balanced\n    )\n\n    # --------------------------------------------------------\n    # Outer validation — untouched\n    # --------------------------------------------------------\n\n    y_pred = best_rf.predict(\n        X_outer_val\n    )\n\n    outer_accuracy = accuracy_score(\n        y_outer_val,\n        y_pred\n    )\n\n    outer_balanced_accuracy = balanced_accuracy_score(\n        y_outer_val,\n        y_pred\n    )\n\n    outer_macro_f1 = f1_score(\n        y_outer_val,\n        y_pred,\n        average=\"macro\",\n        zero_division=0\n    )\n\n    print(\n        f\"Outer Accuracy: \"\n        f\"{outer_accuracy:.6f}\"\n    )\n\n    print(\n        f\"Outer Balanced Accuracy: \"\n        f\"{outer_balanced_accuracy:.6f}\"\n    )\n\n    print(\n        f\"Outer Macro F1: \"\n        f\"{outer_macro_f1:.6f}\"\n    )\n\n    print(\n        f\"Fold time: \"\n        f\"{time.time() - fold_start:.1f} sec\"\n    )\n\n    # -----------------